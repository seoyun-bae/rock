
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    // 1. 문자 배열과 문자열 포인터
    char strArray[] = "Data";
    const char *strPointer = "Data";

    strArray[0] = 'd';

    printf("[1] 문자열 비교\n");
    printf("문자 배열: %s\n", strArray);
    printf("문자열 포인터가 가리키는 문자열: %s\n\n", strPointer);

    // 2. 3행 4열 배열을 위한 동적 메모리 할당
    int (*p)[4] = malloc(3 * sizeof(*p));

    if (p == NULL) {
        printf("메모리 할당 실패\n");
        return 1;
    }

    // 배열에 데이터 저장
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 4; j++) {
            p[i][j] = (i + 1) * 10 + j;
        }
    }

    // 2차원 배열 전체 출력
    printf("[2] 2차원 배열\n");
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 4; j++) {
            printf("%d ", p[i][j]);
        }
        printf("\n");
    }

    // 3. 동적 메모리 해제
    free(p);
    p = NULL;

    printf("\n[3] 동적 메모리 해제 완료\n");

    return 0;
}
